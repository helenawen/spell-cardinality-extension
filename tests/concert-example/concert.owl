<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns="http://example.org/concerts#"
         xml:base="http://example.org/concerts">

  <owl:Ontology rdf:about="http://example.org/concerts">
    <rdfs:comment>Ontology for singers, concerts, and attendance data for testing majority constraints.</rdfs:comment>
  </owl:Ontology>

  <!-- ===== CLASSES ===== -->
  <owl:Class rdf:about="#Singer"/>
  <owl:Class rdf:about="#Concert"/>
  <owl:Class rdf:about="#AttendanceRecord"/>
  <owl:Class rdf:about="#Region"/>
  <owl:Class rdf:about="#Album"/>
  <owl:Class rdf:about="#Genre"/>

  <!-- ===== OBJECT PROPERTIES ===== -->
  <owl:ObjectProperty rdf:about="#performedConcert">
    <rdfs:domain rdf:resource="#Singer"/>
    <rdfs:range rdf:resource="#Concert"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#hasLocation">
    <rdfs:domain rdf:resource="#Concert"/>
    <rdfs:range rdf:resource="#Region"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#hasAttendance">
    <rdfs:domain rdf:resource="#Concert"/>
    <rdfs:range rdf:resource="#AttendanceRecord"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#hasAlbum">
    <rdfs:domain rdf:resource="#Singer"/>
    <rdfs:range rdf:resource="#Album"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#hasGenre">
    <rdfs:domain rdf:resource="#Singer"/>
    <rdfs:range rdf:resource="#Genre"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#collaboratedWith">
    <rdfs:domain rdf:resource="#Singer"/>
    <rdfs:range rdf:resource="#Singer"/>
  </owl:ObjectProperty>

  <!-- ===== DATATYPE PROPERTIES ===== -->
  <owl:DatatypeProperty rdf:about="#numVisitors">
    <rdfs:domain rdf:resource="#AttendanceRecord"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#releasedInYear">
    <rdfs:domain rdf:resource="#Album"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#gYear"/>
  </owl:DatatypeProperty>

  <!-- ===== REGIONS ===== -->
  <owl:NamedIndividual rdf:about="#US"><rdf:type rdf:resource="#Region"/></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#Europe"><rdf:type rdf:resource="#Region"/></owl:NamedIndividual>

  <!-- ===== GENRES ===== -->
  <owl:NamedIndividual rdf:about="#Pop"><rdf:type rdf:resource="#Genre"/></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#Rock"><rdf:type rdf:resource="#Genre"/></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#Jazz"><rdf:type rdf:resource="#Genre"/></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#Country"><rdf:type rdf:resource="#Genre"/></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#Electronic"><rdf:type rdf:resource="#Genre"/></owl:NamedIndividual>

  <!-- ===== ALBUMS ===== -->
  <owl:NamedIndividual rdf:about="#Album_Skyline"><rdf:type rdf:resource="#Album"/><releasedInYear rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2018</releasedInYear></owl:NamedIndividual>
