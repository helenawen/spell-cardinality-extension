  <owl:NamedIndividual rdf:about="#Album_Roadtrip"><rdf:type rdf:resource="#Album"/><releasedInYear rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2017</releasedInYear></owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="#Album_Stars"><rdf:type rdf:resource="#Album"/><releasedInYear rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2016</releasedInYear></owl:NamedIndividual>
