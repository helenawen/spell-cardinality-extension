<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.w3.org/2002/07/owl#"
     xml:base="http://www.w3.org/2002/07/owl"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:schema="http://schema.org/">
    <Ontology/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.w3.org/2001/XMLSchema#date -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- http://www.w3.org/2001/XMLSchema#duration -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#duration"/>
    


    <!-- http://www.w3.org/2001/XMLSchema#gYear -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#gYear"/>
    


    <!-- http://www.w3.org/2001/XMLSchema#gYearMonth -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#gYearMonth"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://bioschemas.org/bioChemInteraction -->

    <ObjectProperty rdf:about="http://bioschemas.org/bioChemInteraction">
        <rdfs:domain rdf:resource="http://bioschemas.org/BioChemEntity"/>
        <rdfs:range rdf:resource="http://bioschemas.org/BioChemEntity"/>
    </ObjectProperty>
    


    <!-- http://bioschemas.org/encodesBioChemEntity -->

    <ObjectProperty rdf:about="http://bioschemas.org/encodesBioChemEntity">
        <inverseOf rdf:resource="http://bioschemas.org/isEncodedByBioChemEntity"/>
        <rdfs:range rdf:resource="http://bioschemas.org/BioChemEntity"/>
    </ObjectProperty>
    


    <!-- http://bioschemas.org/expressedIn -->

    <ObjectProperty rdf:about="http://bioschemas.org/expressedIn">
        <rdfs:range rdf:resource="http://schema.org/Thing"/>
    </ObjectProperty>
    


    <!-- http://bioschemas.org/hasMolecularFunction -->

    <ObjectProperty rdf:about="http://bioschemas.org/hasMolecularFunction">
        <rdfs:domain rdf:resource="http://bioschemas.org/BioChemEntity"/>
        <rdfs:range rdf:resource="http://schema.org/Thing"/>
    </ObjectProperty>
    


    <!-- http://bioschemas.org/isEncodedByBioChemEntity -->

    <ObjectProperty rdf:about="http://bioschemas.org/isEncodedByBioChemEntity">
        <rdfs:domain rdf:resource="http://bioschemas.org/BioChemEntity"/>
    </ObjectProperty>
    


    <!-- http://bioschemas.org/isInvolvedInBiologicalProcess -->

    <ObjectProperty rdf:about="http://bioschemas.org/isInvolvedInBiologicalProcess">
