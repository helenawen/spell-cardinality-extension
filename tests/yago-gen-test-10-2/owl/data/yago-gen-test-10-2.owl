    </ObjectProperty>
    


    <!-- http://schema.org/author -->

    <ObjectProperty rdf:about="http://schema.org/author">
        <rdfs:domain rdf:resource="http://schema.org/CreativeWork"/>
        <rdfs:range>
            <Class>
                <unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://schema.org/Organization"/>
                    <rdf:Description rdf:about="http://schema.org/Person"/>
                </unionOf>
            </Class>
        </rdfs:range>
    </ObjectProperty>
    


    <!-- http://schema.org/award -->

    <ObjectProperty rdf:about="http://schema.org/award">
