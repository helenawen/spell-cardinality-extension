    <!-- http://bioschemas.org/isLocatedInSubcellularLocation -->

    <ObjectProperty rdf:about="http://bioschemas.org/isLocatedInSubcellularLocation">
        <rdfs:domain rdf:resource="http://bioschemas.org/BioChemEntity"/>
        <rdfs:range rdf:resource="http://schema.org/Thing"/>
    </ObjectProperty>
    


    <!-- http://bioschemas.org/parentTaxon -->

    <ObjectProperty rdf:about="http://bioschemas.org/parentTaxon"/>
    


    <!-- http://bioschemas.org/taxonRank -->

    <ObjectProperty rdf:about="http://bioschemas.org/taxonRank">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://schema.org/Thing"/>
    </ObjectProperty>
    


    <!-- http://schema.org/about -->

    <ObjectProperty rdf:about="http://schema.org/about">
        <inverseOf rdf:resource="http://schema.org/subjectOf"/>
        <rdfs:domain>
            <Class>
                <unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://schema.org/CreativeWork"/>
                    <rdf:Description rdf:about="http://schema.org/Event"/>
                </unionOf>
            </Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://schema.org/Thing"/>
    </ObjectProperty>
    


    <!-- http://schema.org/actor -->

    <ObjectProperty rdf:about="http://schema.org/actor">
        <rdfs:range rdf:resource="http://schema.org/Person"/>
    </ObjectProperty>
    


    <!-- http://schema.org/affiliation -->

    <ObjectProperty rdf:about="http://schema.org/affiliation">
        <rdfs:subPropertyOf rdf:resource="http://schema.org/memberOf"/>
        <rdfs:domain rdf:resource="http://schema.org/Person"/>
        <rdfs:range rdf:resource="http://schema.org/Organization"/>
    </ObjectProperty>
    


    <!-- http://schema.org/albumRelease -->

    <ObjectProperty rdf:about="http://schema.org/albumRelease">
        <inverseOf rdf:resource="http://schema.org/releaseOf"/>
    </ObjectProperty>
    


    <!-- http://schema.org/alumni -->

