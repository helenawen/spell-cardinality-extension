        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
    </DatatypeProperty>
    


    <!-- http://schema.org/startDate -->

    <DatatypeProperty rdf:about="http://schema.org/startDate">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://schema.org/Event"/>
        <rdfs:range>
            <rdfs:Datatype>
                <unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#dateTime"/>
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#gYear"/>
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#gYearMonth"/>
                </unionOf>
            </rdfs:Datatype>
        </rdfs:range>
    </DatatypeProperty>
    


    <!-- http://schema.org/telephone -->

    <DatatypeProperty rdf:about="http://schema.org/telephone">
        <rdfs:domain>
            <Class>
                <unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://schema.org/Organization"/>
                    <rdf:Description rdf:about="http://schema.org/Person"/>
                    <rdf:Description rdf:about="http://schema.org/Place"/>
                </unionOf>
            </Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </DatatypeProperty>
    


    <!-- http://schema.org/url -->

    <DatatypeProperty rdf:about="http://schema.org/url">
