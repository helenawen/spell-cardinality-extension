<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns="http://example.org/interests#"
         xml:base="http://example.org/interests">

    <owl:Ontology rdf:about="http://example.org/interests">
        <rdfs:comment>Ontology describing individuals with interests in tech and art for majority constraint testing.</rdfs:comment>
    </owl:Ontology>

    <!-- Classes -->
    <owl:Class rdf:about="#Person"/>
    <owl:Class rdf:about="#ArtActivity"/>
    <owl:Class rdf:about="#TechActivity"/>

    <!-- Object properties -->
    <owl:ObjectProperty rdf:about="#doesArt">
        <rdfs:domain rdf:resource="#Person"/>
        <rdfs:range rdf:resource="#ArtActivity"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#doesTech">
        <rdfs:domain rdf:resource="#Person"/>
        <rdfs:range rdf:resource="#TechActivity"/>
    </owl:ObjectProperty>

    <!-- Art activities -->
    <owl:NamedIndividual rdf:about="#Painting"><rdf:type rdf:resource="#ArtActivity"/></owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Sculpting"><rdf:type rdf:resource="#ArtActivity"/></owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Photography"><rdf:type rdf:resource="#ArtActivity"/></owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Dancing"><rdf:type rdf:resource="#ArtActivity"/></owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Music"><rdf:type rdf:resource="#ArtActivity"/></owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Theatre"><rdf:type rdf:resource="#ArtActivity"/></owl:NamedIndividual>

    <!-- Tech activities -->
    <owl:NamedIndividual rdf:about="#Programming"><rdf:type rdf:resource="#TechActivity"/></owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Robotics"><rdf:type rdf:resource="#TechActivity"/></owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#AIResearch"><rdf:type rdf:resource="#TechActivity"/></owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Electronics"><rdf:type rdf:resource="#TechActivity"/></owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#CyberSecurity"><rdf:type rdf:resource="#TechActivity"/></owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#3DModeling"><rdf:type rdf:resource="#TechActivity"/></owl:NamedIndividual>

    <!-- People -->
    <!-- 4 Positive (majority Tech) -->
    <owl:NamedIndividual rdf:about="#Alice">
        <rdf:type rdf:resource="#Person"/>
        <doesTech rdf:resource="#Programming"/>
        <doesTech rdf:resource="#AIResearch"/>
        <doesTech rdf:resource="#CyberSecurity"/>
        <doesArt rdf:resource="#Photography"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#Ben">
        <rdf:type rdf:resource="#Person"/>
        <doesTech rdf:resource="#Programming"/>
        <doesTech rdf:resource="#Electronics"/>
        <doesTech rdf:resource="#Robotics"/>
        <doesTech rdf:resource="#AIResearch"/>
        <doesArt rdf:resource="#Music"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#Carla">
        <rdf:type rdf:resource="#Person"/>
        <doesTech rdf:resource="#CyberSecurity"/>
        <doesTech rdf:resource="#AIResearch"/>
        <doesTech rdf:resource="#3DModeling"/>
        <doesArt rdf:resource="#Painting"/>
