        <rdf:type rdf:resource="#Person"/>
        <doesTech rdf:resource="#Robotics"/>
        <doesTech rdf:resource="#Programming"/>
        <doesTech rdf:resource="#Electronics"/>
        <doesArt rdf:resource="#Theatre"/>
    </owl:NamedIndividual>

    <!-- 6 Negative (majority Art) -->
    <owl:NamedIndividual rdf:about="#Eva">
        <rdf:type rdf:resource="#Person"/>
        <doesArt rdf:resource="#Painting"/>
        <doesArt rdf:resource="#Sculpting"/>
        <doesArt rdf:resource="#Dancing"/>
        <doesTech rdf:resource="#Electronics"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#Frank">
        <rdf:type rdf:resource="#Person"/>
        <doesArt rdf:resource="#Music"/>
        <doesArt rdf:resource="#Painting"/>
        <doesArt rdf:resource="#Theatre"/>
        <doesTech rdf:resource="#Programming"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#Grace">
        <rdf:type rdf:resource="#Person"/>
        <doesArt rdf:resource="#Sculpting"/>
        <doesArt rdf:resource="#Photography"/>
        <doesArt rdf:resource="#Painting"/>
        <doesArt rdf:resource="#Dancing"/>
        <doesTech rdf:resource="#3DModeling"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#Hannah">
        <rdf:type rdf:resource="#Person"/>
        <doesArt rdf:resource="#Photography"/>
        <doesArt rdf:resource="#Music"/>
        <doesArt rdf:resource="#Theatre"/>
        <doesTech rdf:resource="#Robotics"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#Ian">
        <rdf:type rdf:resource="#Person"/>
        <doesArt rdf:resource="#Painting"/>
        <doesArt rdf:resource="#Dancing"/>
        <doesArt rdf:resource="#Music"/>
        <doesTech rdf:resource="#AIResearch"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#Julia">
        <rdf:type rdf:resource="#Person"/>
        <doesArt rdf:resource="#Painting"/>
        <doesArt rdf:resource="#Sculpting"/>
        <doesArt rdf:resource="#Theatre"/>
        <doesTech rdf:resource="#3DModeling"/>
    </owl:NamedIndividual>

    <!-- Remaining 40 Neutral or Mixed Individuals -->
    <owl:NamedIndividual rdf:about="#Kevin"><rdf:type rdf:resource="#Person"/><doesTech rdf:resource="#Programming"/><doesArt rdf:resource="#Photography"/></owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Laura"><rdf:type rdf:resource="#Person"/><doesTech rdf:resource="#Electronics"/><doesArt rdf:resource="#Music"/></owl:NamedIndividual>
