    <owl:NamedIndividual rdf:about="#Sam"><rdf:type rdf:resource="#Person"/><doesTech rdf:resource="#AIResearch"/><doesArt rdf:resource="#Theatre"/></owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="#Tina"><rdf:type rdf:resource="#Person"/><doesTech rdf:resource="#Electronics"/><doesTech rdf:resource="#Robotics"/></owl:NamedIndividual>
